# Maintainer: Ilker Keklik <ilkerkeklik50@gmail.com>
pkgname=yt-stash
pkgver=1.0.1
pkgrel=1
pkgdesc="Download YouTube videos and playlists from the terminal"
arch=('any')
url="https://github.com/ilkerkeklik01/yt-stash"
license=('MIT')
depends=('python' 'yt-dlp' 'python-rich' 'python-questionary' 'ffmpeg' 'deno')
makedepends=('python-build' 'python-installer' 'python-hatchling')
source=("https://files.pythonhosted.org/packages/source/y/yt-stash/yt_stash-${pkgver}.tar.gz")
sha256sums=('fa4e49b695e89a9b84bd4da3b7d3116a575ccdc23b3d70402665460b7f9db8a3')

build() {
  cd "yt_stash-${pkgver}"
  python -m build --wheel --no-isolation
}

package() {
  cd "yt_stash-${pkgver}"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
