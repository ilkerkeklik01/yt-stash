{
    "version": "1.0.1",
    "description": "Download YouTube videos and playlists from the terminal",
    "homepage": "https://github.com/ilkerkeklik01/yt-stash",
    "license": "MIT",
    "depends": ["python", "ffmpeg", "deno"],
    "url": "https://files.pythonhosted.org/packages/d0/a4/ac84e88b5d13017cbf228515567813087662d27c2448135dff55b10341b3/yt_stash-1.0.1-py3-none-any.whl",
    "hash": "92cfabfb8d7d07585da3ed6fb3a2e984aee25ec7b3c38a8f00d55578b7472b8f",
    "installer": {
        "script": [
            "python -m venv \"$dir\\venv\"",
            "& \"$dir\\venv\\Scripts\\python.exe\" -m pip install --no-warn-script-location --disable-pip-version-check \"$dir\\yt_stash-$version-py3-none-any.whl\""
        ]
    },
    "bin": [["venv\\Scripts\\yt-stash.exe", "yt-stash"]],
    "checkver": {
        "url": "https://pypi.org/pypi/yt-stash/json",
        "jsonpath": "$.info.version"
    },
    "autoupdate": {
        "url": "https://files.pythonhosted.org/packages/py3/y/yt-stash/yt_stash-$version-py3-none-any.whl",
        "hash": {
            "url": "https://pypi.org/pypi/yt-stash/$version/json",
            "jsonpath": "$.urls[?(@.packagetype=='bdist_wheel')].digests.sha256"
        }
    }
}
